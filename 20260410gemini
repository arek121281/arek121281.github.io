let filePerms = { user: 7, group: 5, other: 4 }; // rwxr-xr--
let dirPerms = { user: 7, group: 5, other: 0 };  // rwxr-x---

function permsToSymbolic(perms, isDir) {
    let s = isDir ? 'd' : '-';
    s += (perms.user & 4) ? 'r' : '-';
    s += (perms.user & 2) ? 'w' : '-';
    if (perms.suid) s += 's'; else s += (perms.user & 1) ? 'x' : '-';
    
    s += (perms.group & 4) ? 'r' : '-';
    s += (perms.group & 2) ? 'w' : '-';
    if (perms.sgid) s += 's'; else s += (perms.group & 1) ? 'x' : '-';

    s += (perms.other & 4) ? 'r' : '-';
    s += (perms.other & 2) ? 'w' : '-';
    if (perms.sticky) s += 't'; else s += (perms.other & 1) ? 'x' : '-';
    
    return s;
}

function updateSimDisplay() {
    let fileSymbolic = permsToSymbolic(filePerms, false);
    let dirSymbolic = permsToSymbolic(dirPerms, true);
    
    simOutput.textContent = 
        `${fileSymbolic} 1 user dev 1024 Nov 13 12:00 skrypt.sh\n` +
        `${dirSymbolic} 2 user dev 4096 Nov 13 12:01 projekt/`;
