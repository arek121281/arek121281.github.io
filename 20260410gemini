<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Uprawnienia w Linux: Pliki vs Katalogi (Advanced)</title>
    <style>
        :root {
            /* Motyw Systemów Operacyjnych / Hardware */
            --primary: #0f172a; 
            --os-cyan: #06b6d4;
            --os-indigo: #4f46e5;
            --os-light: #e0f2fe;
            
            --green: #10b981;
            --yellow: #f59e0b;
            --red: #f43f5e;
            --bg: #f8fafc;
            --card: #ffffff;
            --text: #334155;
            --muted: #64748b;
            --shadow: 0 10px 40px rgba(0,0,0,0.08);
            --radius: 16px;
            --term-bg: #020617;
        }
        *{margin:0;padding:0;box-sizing:border-box}
        html{scroll-behavior:smooth;scroll-padding-top:70px}
        body{font-family:'Segoe UI',system-ui,-apple-system,sans-serif;background:var(--bg);color:var(--text);line-height:1.7}

        /* NAV */
        nav{position:fixed;top:0;width:100%;z-index:1000;background:rgba(15, 23, 42, 0.98);backdrop-filter:blur(10px);box-shadow:0 2px 20px rgba(0,0,0,0.2)}
        .nav-inner{max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;padding:0 24px}
        .logo{color:#fff;font-weight:900;font-size:1.3rem;padding:16px 0;display:flex;align-items:center;gap:8px;font-family: 'Courier New', Courier, monospace;}
        .logo span{color:var(--os-cyan)}
        nav ul{display:flex;list-style:none;gap:0;flex-wrap:wrap}
        nav ul li a{display:block;color:#cbd5e1;text-decoration:none;padding:17px 16px;font-size:.85rem;font-weight:600;transition:.3s;border-bottom:3px solid transparent}
        nav ul li a:hover{color:var(--os-cyan);border-bottom-color:var(--os-cyan);background:rgba(6, 182, 212, 0.1)}
        .menu-btn{display:none;background:none;border:none;color:#fff;font-size:1.5rem;cursor:pointer}

        /* HERO */
        .hero{background:linear-gradient(135deg, #020617 0%, #0f172a 50%, #1e1b4b 100%);color:#fff;text-align:center;padding:160px 24px 120px;position:relative;overflow:hidden}
        .hero::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 20% 30%,rgba(6, 182, 212, 0.15),transparent 50%);animation:pulse 8s infinite alternate}
        @keyframes pulse{0%{opacity:0.5;transform:scale(1)}100%{opacity:1;transform:scale(1.2)}}
        .hero>*{position:relative;z-index:1}
        .hero-icon{font-size:5.5rem;margin-bottom:15px;filter:drop-shadow(0 10px 20px rgba(6, 182, 212, 0.4));animation:float 4s ease-in-out infinite}
        @keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-15px)}}
        .hero h1{font-size:3.8rem;font-weight:900;margin-bottom:15px;letter-spacing:-1px}
        .hero h1 span{color:var(--os-cyan)}
        .hero>p{font-size:1.25rem;color:#cbd5e1;max-width:700px;margin:0 auto 35px}
        .hero-chips{display:flex;justify-content:center;gap:14px;flex-wrap:wrap}
        .chip{background:rgba(255,255,255,0.1);border:1px solid rgba(255,255,255,0.2);padding:12px 24px;border-radius:30px;backdrop-filter:blur(5px);font-weight:700;letter-spacing:1px;font-size:0.9rem;font-family:monospace;}
        .chip:nth-child(1){color:var(--os-cyan)}
        .chip:nth-child(2){color:#818cf8}
        .chip:nth-child(3){color:var(--green)}

        /* UTILS */
        .container{max-width:1000px;margin:0 auto;padding:0 24px}
        section{padding:100px 0}
        .stitle{text-align:center;margin-bottom:60px}
        .stitle h2{font-size:2.4rem;font-weight:800;color:var(--primary)}
        .stitle .line{width:60px;height:5px;margin:15px auto;background:linear-gradient(90deg,var(--os-indigo),var(--os-cyan));border-radius:3px}
        .stitle p{color:var(--muted);font-size:1.1rem;max-width:600px;margin:0 auto}
        .alt-bg{background:#e2e8f0}

        /* CARDS */
        .card{background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow);padding:40px;margin-bottom:30px;transition:transform .3s, box-shadow .3s}
        .card:hover{transform:translateY(-4px);box-shadow:0 15px 45px rgba(0,0,0,0.1)}
        .card h3{font-size:1.6rem;margin-bottom:16px;color:var(--primary);display:flex;align-items:center;gap:10px}
        .card p, .card li{font-size:1.05rem;color:var(--text);margin-bottom:10px}
        .card ul{padding-left:24px}

        /* CODE BLOCK */
        .code-block{background:var(--term-bg);color:#d4d4d4;font-family:'Consolas','Courier New',monospace;padding:25px;border-radius:10px;margin:20px 0;overflow-x:auto;font-size:0.95rem;line-height:1.6;border-top:15px solid #1e293b;position:relative;}
        .code-block::before{content:'● ● ●';position:absolute;top:-13px;left:10px;color:#cbd5e1;font-size:0.5rem;letter-spacing:3px;}
        .cmd{color:var(--green);font-weight:bold;} /* command */
        .arg{color:#60a5fa} /* arguments */
        .str{color:#fcd34d} /* strings */
        .cm{color:#64748b} /* comment */
        .op{color:var(--os-cyan)} /* operators */
        .prompt{color:var(--os-indigo)}
        .out{color:#94a3b8}

        /* TABLES */
        .tw{overflow-x:auto;border-radius:12px;box-shadow:var(--shadow);margin:25px 0}
        table{width:100%;border-collapse:collapse;background:var(--card)}
        th{background:var(--primary);color:#fff;padding:16px;text-align:left;font-size:0.9rem;text-transform:uppercase}
        td{padding:14px 16px;border-bottom:1px solid #e2e8f0;font-size:0.95rem;font-family:monospace;}
        td:last-child{font-family:inherit;}
        tr:last-child td{border-bottom:none}
        tr:nth-child(even){background:var(--os-light)}
        .badge{padding:4px 10px;border-radius:20px;font-size:0.8rem;font-weight:700}
        .b-dan{background:#fee2e2;color:#991b1b}
        .b-safe{background:#d1fae5;color:#065f46}

        /* SIMULATOR */
        .sim-wrap{background:var(--primary);border-radius:var(--radius);padding:40px;box-shadow:var(--shadow);border:1px solid #1e293b; color: white;}
        .sim-header{text-align:center;margin-bottom:25px}
        .sim-header h3{font-size:1.8rem;color:var(--os-cyan);margin-bottom:5px;display:flex;align-items:center;justify-content:center;gap:10px; font-family:monospace;}
        
        .sim-grid { display: grid; grid-template-columns: 1.5fr 1fr; gap: 20px;}
        @media(max-width: 800px) { .sim-grid { grid-template-columns: 1fr; } }
        
        .sim-term-input { background: #020617; border: 1px solid #334155; border-radius: 8px; padding: 12px 15px; font-family: monospace; font-size: 1.1rem; color: #e2e8f0; width: 100%; outline: none;}
        .sim-term-input:focus { border-color: var(--os-cyan); }

        .sim-output { background: var(--term-bg); font-family: monospace; padding: 20px; border-radius: 8px; min-height: 200px; color: #9ca3af; font-size: 0.95rem; border-left: 4px solid var(--os-indigo); white-space: pre-wrap; }
        
        .explanation { background: rgba(6, 182, 212, 0.05); border-left: 4px solid var(--os-cyan); padding: 15px; border-radius: 8px; margin-top: 15px; font-size: 0.9rem;}

        /* QUIZ ENGINE */
        .qbox{background:var(--card);border-radius:20px;padding:45px;box-shadow:0 20px 50px rgba(0,0,0,0.1);border-top:6px solid var(--os-cyan)}
        .qmeta{display:flex;justify-content:space-between;color:var(--muted);font-weight:600;font-size:0.95rem;margin-bottom:20px;padding-bottom:15px;border-bottom:2px dashed #e2e8f0}
        .qq{font-size:1.35rem;font-weight:700;color:var(--primary);margin-bottom:25px;line-height:1.4}
        .qcode{background:#f1f5f9;padding:15px 20px;border-radius:8px;font-family:'Consolas',monospace;font-size:1.05rem;color:#0f172a;margin-bottom:25px;border-left:4px solid var(--os-indigo)}
        .qopts{display:grid;grid-template-columns:1fr;gap:12px}
        .qopt{background:#f8fafc;padding:18px 20px;border:2px solid #cbd5e1;border-radius:12px;cursor:pointer;transition:all .2s;font-size:1.05rem;font-weight:500;display:flex;align-items:center;gap:15px;font-family:monospace;}
        .qopt::before{content:'>';font-weight:bold;color:#cbd5e1;display:inline-block;transition:0.3s}
        .qopt:hover{border-color:var(--os-cyan);background:var(--os-light)}
        .qopt.ok{border-color:var(--green);background:#ecfdf5;color:#166534}
        .qopt.ok::before{content:'✔';color:var(--green)}
        .qopt.no{border-color:var(--red);background:#fef2f2;color:#991b1b}
        .qopt.no::before{content:'✖';color:var(--red)}
        
        .qfb{padding:20px;border-radius:12px;margin-top:20px;font-size:1rem;line-height:1.6;display:none;animation:fadeIn 0.5s ease}
        @keyframes fadeIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}
        .qfb.show{display:block}
        .qfb.success{background:#d1fae5;color:#065f46;border-left:4px solid var(--green)}
        .qfb.error{background:#fee2e2;color:#991b1b;border-left:4px solid var(--red)}
        
        .qnav{display:flex;justify-content:flex-end;margin-top:25px}
        .qnav .btn{background:var(--primary);color:#fff;padding:14px 35px;font-size:1.05rem;border:none;border-radius:8px;font-weight:bold;cursor:pointer;transition:.2s}
        .qnav .btn:hover{background:var(--os-indigo)}
        .qnav .btn:disabled{opacity:0.4;cursor:not-allowed;transform:none;box-shadow:none}
        
        /* RESULT SCREEN */
        .res-screen{text-align:center;padding:20px 0}
        .res-icon{font-size:4.5rem;margin-bottom:15px}
        .res-title{font-size:2.2rem;color:var(--primary);margin-bottom:10px}
        .res-score{font-size:4.5rem;font-weight:900;color:var(--os-cyan);margin:20px 0;text-shadow:0 5px 15px rgba(6, 182, 212, 0.3)}
        .res-desc{font-size:1.2rem;color:var(--text);max-width:500px;margin:0 auto 30px}

        /* FOOTER */
        footer{background:#020617;color:#94a3b8;text-align:center;padding:50px 24px;border-top:1px solid #0f172a}
        footer span{color:var(--os-cyan)}

        /* ANIM */
        .fin{opacity:0;transform:translateY(30px);transition:all .8s cubic-bezier(0.2, 0.8, 0.2, 1)}
        .fin.vis{opacity:1;transform:translateY(0)}

        @media(max-width:768px){
            .hero h1{font-size:2.5rem}
            .hero-icon{font-size:4.5rem}
            .stitle h2{font-size:2rem}
            .card{padding:25px}
            nav ul{display:none}
            .menu-btn{display:block}
            .qbox{padding:25px}
        }
    </style>
</head>
