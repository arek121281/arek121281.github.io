function explainPerms(target, perms, isDir) {
    let exp = `<strong>${target}: ${permsToSymbolic(perms, isDir)}</strong><br>`;
    
    const readMeaning = isDir ? "listować nazwy plików wewnątrz." : "odczytać zawartość.";
    const writeMeaning = isDir ? "tworzyć/usuwać/zmieniać nazwy plików wewnątrz." : "modyfikować zawartość.";
    const execMeaning = isDir ? "wejść do katalogu (użyć 'cd')." : "uruchomić jako program.";

    exp += "• Właściciel ('user') może ";
    if (perms.user === 0) exp += "nic nie robić. ";
    else exp += [perms.user & 4 ? readMeaning : '', perms.user & 2 ? writeMeaning : '', perms.user & 1 ? execMeaning : ''].filter(Boolean).join(' ');
    
    exp += "<br>• Grupa ('dev') może ";
    if (perms.group === 0) exp += "nic nie robić. ";
    else exp += [perms.group & 4 ? readMeaning : '', perms.group & 2 ? writeMeaning : '', perms.group & 1 ? execMeaning : ''].filter(Boolean).join(' ');

    exp += "<br>• Inni ('others') mogą ";
    if (perms.other === 0) exp += "nic nie robić. ";
    else exp += [perms.other & 4 ? readMeaning : '', perms.other & 2 ? writeMeaning : '', perms.other & 1 ? execMeaning : ''].filter(Boolean).join(' ');

    if(perms.suid) exp += "<br><strong style='color: var(--red)'>• SUID:</strong> Program będzie uruchamiany z uprawnieniami właściciela!";
    if(perms.sgid && !isDir) exp += "<br><strong style='color: var(--yellow)'>• SGID:</strong> Program będzie uruchamiany z uprawnieniami grupy!";
    if(perms.sgid && isDir) exp += "<br><strong style='color: var(--yellow)'>• SGID:</strong> Nowe pliki w tym katalogu odziedziczą grupę 'dev'!";
    if(perms.sticky) exp += "<br><strong style='color: var(--os-indigo)'>• Sticky Bit:</strong> Tylko właściciel pliku może go usunąć z tego katalogu!";
    
    return exp;
}

chmodInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
        const command = e.target.value.trim();
        e.target.value = '';
        const parts = command.split(' ');
        
        if (parts[0] !== 'chmod' || parts.length < 3) {
            simExplanation.innerHTML = "<strong style='color: var(--red)'>Błąd:</strong> Nieprawidłowa komenda. Użyj np. `chmod 777 skrypt.sh` lub `chmod u+x projekt/`";
            return;
        }

        const mode = parts[1];
        const target = parts[2];
        let targetPerms = (target.includes('skrypt')) ? filePerms : dirPerms;
        
        // Handle octal
        const octalMatch = mode.match(/^[0-7]{3,4}$/);
        if (octalMatch) {
            let m = mode;
            if (m.length === 3) m = '0' + m;
            targetPerms.suid = (parseInt(m[0]) & 4) > 0;
            targetPerms.sgid = (parseInt(m[0]) & 2) > 0;
            targetPerms.sticky = (parseInt(m[0]) & 1) > 0;
            targetPerms.user = parseInt(m[1]);
            targetPerms.group = parseInt(m[2]);
            targetPerms.other = parseInt(m[3]);
        } 
        // Handle symbolic (simplified)
        else {
             const symbolicMatch = mode.match(/([augo]*)?([+\-=])([rwxst]*)/);
             if(symbolicMatch) {
                let who = symbolicMatch[1] || 'a';
                const op = symbolicMatch[2];
                const what = symbolicMatch[3];
                
                const targets = [];
                if(who.includes('u') || who.includes('a')) targets.push('user');
                if(who.includes('g') || who.includes('a')) targets.push('group');
                if(who.includes('o') || who.includes('a')) targets.push('other');

                let mask = 0;
                if(what.includes('r')) mask |= 4;
                if(what.includes('w')) mask |= 2;
                if(what.includes('x')) mask |= 1;

                targets.forEach(t => {
                    if (op === '+') targetPerms[t] |= mask;
                    else if (op === '-') targetPerms[t] &= ~mask;
                    else if (op === '=') targetPerms[t] = mask;
                });
                
                if(what.includes('s') && (who.includes('u') || who.includes('a'))) targetPerms.suid = (op === '+');
                if(what.includes('s') && (who.includes('g') || who.includes('a'))) targetPerms.sgid = (op === '+');
                if(what.includes('t') && (who.includes('o') || who.includes('a'))) targetPerms.sticky = (op === '+');

             } else {
                 simExplanation.innerHTML = "<strong style='color: var(--red)'>Błąd:</strong> Nieobsługiwana składnia chmod.";
                 return;
             }
        }
        
        simExplanation.innerHTML = explainPerms(target, targetPerms, target.includes('projekt'));
        updateSimDisplay();
    }
});

